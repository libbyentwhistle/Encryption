        "encrypted=\"\"\n",
        "decrypted=\"\"\n",
        "\n",
        "encrypted=str(input(\"Enter the encrypted message here: \"))\n",
        "i=len(encrypted)-1\n",
        "\n",
        "while i >= 0:\n",
        "  decrypted=decrypted + encrypted[i]\n",
        "  i=i-1\n",
        "print(\"The decrypted message is: \" + decrypted)"
